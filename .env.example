# Copy this file to ".env" for local development only. Never commit .env.
# On Render/Railway, set these in the service's "Environment" settings instead.

# Postgres connection string (Neon, Render, Railway, or local).
DATABASE_URL=postgres://crewmatch:crewmatch@localhost:5432/crewmatch_dev

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# The one admin login (the /admin page).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# "development" locally, "production" when hosted.
NODE_ENV=development

# Set to "true" to load invented sample crew and productions on startup
# (only when the database has no users yet). Turn off before real users arrive.
SEED_SAMPLE_DATA=false

# Payments. Only "stub" exists today: no real money moves. See README.
PAYMENTS_MODE=stub

# Set to "true" only if your Postgres provider needs SSL but uses a self-signed
# certificate. Neon, Render and Railway work with the default.
# DATABASE_SSL_NO_VERIFY=false

# Port is set automatically by Render/Railway. 3000 locally.
# PORT=3000
