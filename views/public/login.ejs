<%- include('../partials/header') %>
<section class="card narrow">
  <h1><%= label %> log in</h1>
  <form method="post" action="/<%= type %>/login">
    <%- include('../partials/csrf') %>
    <label for="email">Email</label>
    <input id="email" name="email" type="email" required value="<%= values.email || '' %>" autocomplete="email">
    <label for="password">Password</label>
    <input id="password" name="password" type="password" required autocomplete="current-password">
    <button type="submit">Log in</button>
  </form>
  <% if (type === 'crew') { %>
    <p class="muted">New here? <a href="/crew/signup">Join as crew</a>. Hiring? <a href="/production/login">Production log in</a>.</p>
  <% } else { %>
    <p class="muted">New here? <a href="/production/signup">Sign up as a production</a>. Crew? <a href="/crew/login">Crew log in</a>.</p>
  <% } %>
</section>
<%- include('../partials/footer') %>
