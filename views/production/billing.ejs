<%- include('../partials/header') %>
<h1>Billing</h1>
<% if (paymentsAreStub) { %>
  <p class="flash info">Test mode: payments are simulated. No card is asked for and no money is charged.</p>
<% } %>
<section class="card">
  <h2><%= subscriptionQuote.name %></h2>
  <p><%= formatMoney(subscriptionQuote.amountCents, subscriptionQuote.currency) %> for <%= subscriptionQuote.periodDays %> days. Covers every project you open while it is active.</p>
  <% if (subscription) { %>
    <p>Active until <strong><%= formatDate(subscription.current_period_end) %></strong>.</p>
  <% } %>
  <form method="post" action="/production/billing/subscribe" data-confirm="Pay <%= formatMoney(subscriptionQuote.amountCents) %> for <%= subscriptionQuote.periodDays %> days?">
    <%- include('../partials/csrf') %>
    <button><%= subscription ? 'Extend by ' + subscriptionQuote.periodDays + ' days' : 'Start subscription' %></button>
  </form>
  <p class="small muted">Or pay per project from each project's page. <a href="/pricing">See prices</a>.</p>
</section>
<section class="card">
  <h2>Payment history</h2>
  <% if (!payments.length) { %><p class="muted">No payments yet.</p><% } else { %>
  <table>
    <thead><tr><th>Date</th><th>What</th><th>Amount</th><th>Status</th></tr></thead>
    <tbody>
      <% payments.forEach(function (p) { %>
        <tr><td><%= p.created_at.toISOString().slice(0, 10) %></td><td><%= p.description %></td><td><%= formatMoney(p.amount_cents, p.currency) %></td><td><%= p.status %><%= p.provider === 'stub' ? ' (test)' : '' %></td></tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</section>
<%- include('../partials/footer') %>
